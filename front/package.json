{
  "name": "platform-template-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "audit:local-assets": "node scripts/audit-local-assets.mjs",
    "audit:code-docs": "node scripts/check-code-documentation.mjs",
    "build": "npm run audit:local-assets && npm run audit:code-docs && vue-tsc --noEmit -p tsconfig.app.json && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "type:check": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^14.0.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vue-tsc": "^3.3.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
